@echo off
title ANALOG TV 3.0 CAMCORDER - GITHUB PAGES AND APK DEPLOYER (f1nal-b0ss)

echo.
echo ============================================================================
echo   ANALOG TV 3.0 CAMCORDER - GITHUB PAGES AND APK DEPLOYER
echo   Account    : https://github.com/f1nal-b0ss
echo   Repository : https://github.com/f1nal-b0ss/AnalogTV-Android-Camcorder
echo   Pages URL  : https://f1nal-b0ss.github.io/AnalogTV-Android-Camcorder/
echo   Pages Setup: https://github.com/f1nal-b0ss/AnalogTV-Android-Camcorder/settings/pages
echo ============================================================================
echo.

where git >nul 2>nul
if errorlevel 1 goto :no_git

powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 goto :ps_err

powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 goto :ps_err

echo [3/6] Initializing Git repository on branch main...
if not exist ".git" git init
git checkout -B main

echo [4/6] Staging all project files, shaders, and GitHub Pages live demo...
git add -A
git commit -m "Deploy GitHub Pages live web app (main + gh-pages) and Android APK CI"

echo [5/6] Pushing to main and gh-pages branches on GitHub...
git remote remove origin >nul 2>nul
git remote add origin https://github.com/f1nal-b0ss/AnalogTV-Android-Camcorder.git
git push -u origin main --force
git push origin main:gh-pages --force

echo.
echo ============================================================================
echo   [6/6] IMPORTANT: ACTIVATE GITHUB PAGES IF SHOWING 404
echo   GitHub has now received both 'main' and 'gh-pages' branches!
echo   If https://f1nal-b0ss.github.io/AnalogTV-Android-Camcorder/ shows 404:
echo     1. Make sure the repository is set to PUBLIC (not Private).
echo     2. In the browser tab opening now (.../settings/pages):
echo        - Under "Build and deployment -> Source", select "Deploy from a branch"
echo        - Select branch "gh-pages" (or "main") and folder "/ (root)" (or "/docs")
echo        - Click Save, then wait ~60 seconds and refresh the Pages URL!
echo ============================================================================
echo.
start "" "https://github.com/f1nal-b0ss/AnalogTV-Android-Camcorder/settings/pages"
start "" "https://f1nal-b0ss.github.io/AnalogTV-Android-Camcorder/"
pause
exit /b 0

:no_git
echo [ERROR] Git is not installed or not in your PATH.
echo         Download Git for Windows from: https://git-scm.com/download/win
pause
exit /b 1

:ps_err
echo [ERROR] PowerShell file preparation failed.
pause
exit /b 1
